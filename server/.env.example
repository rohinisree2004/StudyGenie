# StudyGenie Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/studygenie?retryWrites=true&w=majority

# JSON Web Token Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Allowed Frontend URLs for CORS
CLIENT_URL=http://localhost:5173,https://your-studygenie-app.vercel.app

# Initial Admin Seeding Credentials (for npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@studygenie.com
ADMIN_PASSWORD=Admin@StudyGenie2026!

# Cloudinary Configuration (for Avatar & Courseware File Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI API Key (for AI Assistant, Planner, Summarizer, Quizzes, Recommendations)
GEMINI_API_KEY=your_gemini_api_key_here
